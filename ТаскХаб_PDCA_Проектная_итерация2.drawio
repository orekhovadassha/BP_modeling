        <mxCell id="do_1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Times New Roman;fontSize=11;" value="&lt;b&gt;Продуктовый аналитик&lt;/b&gt; готовит выборку данных для обучения модели, определяет целевую&amp;nbsp;&lt;div&gt;переменную (hire = 1/0);&lt;/div&gt;" vertex="1">
